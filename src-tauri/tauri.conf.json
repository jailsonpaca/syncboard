{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncBoard",
  "version": "2.0.0",
  "identifier": "com.syncboard.app",
  "build": {
    "beforeDevCommand": "npm --prefix client run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix client run build",
    "frontendDist": "../client/dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/tray-template-22.png": "icons/tray-template-22.png",
      "icons/tray-32.png": "icons/tray-32.png",
      "../client/dist/**/*": "client/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
