{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for SyncBoard windows",
  "windows": ["main", "compact", "prefs"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:default",
    "notification:default",
    "opener:default",
    "global-shortcut:default",
    "autostart:default"
  ]
}
